# MariaDB 12.3 option file
#
# 适用环境：
#   Linux 单机容器（Ubuntu 24.04 / phusion baseimage），独立跑 MariaDB，
#   不是 Galera/多主，也不是和应用挤在同一小 cgroup 里抢内存。
#   时区 Asia/Shanghai（+8），监听 0.0.0.0:3306，数据目录本地盘 /data/mysql。
# 适用硬件（按当前 innodb_buffer_pool_size=1G、max_connections=200 估算）：
#   推荐 2–4 vCPU、4 GiB RAM、本地 SSD/NVMe。
#   最低约 2 GiB RAM（偏紧）；内存更大时应先加大 innodb_buffer_pool_size（约 50–70%）。
#   机械硬盘或共享/远程块存储需另调 I/O 与 redo，不要直接套用。
# 负载取向：中小 OLTP，偏耐久（innodb_flush_log_at_trx_commit=1、sync_binlog=1），
#   不是大分析库或超高并发写入。
#
# Groups: https://mariadb.com/docs/server/server-management/install-and-upgrade-mariadb/configuring-mariadb/configuring-mariadb-with-option-files.md
# InnoDB:  https://mariadb.com/docs/server/server-usage/storage-engines/innodb/innodb-system-variables.md
# Charset: https://mariadb.com/docs/server/reference/data-types/string-data-types/character-sets/setting-character-sets-and-collations.md

[client-server]
port                                 = 3306
socket                               = /tmp/mysql.sock
default-character-set                = utf8mb4

[client]
default-character-set                = utf8mb4

[client-mariadb]
default-character-set                = utf8mb4

[mariadbd]
user                                 = www-data
basedir                              = /usr/local/mysql
datadir                              = /data/mysql
tmpdir                               = /tmp
pid-file                             = /data/mysql/mariadb.pid
bind-address                         = 0.0.0.0
skip_name_resolve                    = ON
default-time-zone                    = '+8:00'

# MariaDB 11.6+: utf8mb4 / utf8mb4_uca1400_ai_ci (not MySQL utf8mb4_0900_ai_ci)
character-set-server                 = utf8mb4
collation-server                     = utf8mb4_uca1400_ai_ci

tls_version                          = TLSv1.2,TLSv1.3

max_connections                      = 200
max_allowed_packet                   = 64M

# --------------------------
# Logging
# --------------------------
log_error                            = /data/mysql/mariadb_error.log
general_log                          = OFF
general_log_file                     = /data/mysql/mariadb_general.log
slow_query_log                       = ON
long_query_time                      = 2
slow_query_log_file                  = /data/mysql/mariadb_slow.log

# PITR / replication. Basename avoids hostname-dependent log names.
log_bin                              = mariadb-bin
binlog_format                        = MIXED
sync_binlog                          = 1
binlog_expire_logs_seconds           = 1209600

# --------------------------
# InnoDB
# Official default buffer pool is 128MiB; raise per host RAM (often ~50-70%).
# innodb_buffer_pool_instances was removed in 10.5+ and is ignored.
# Redo size is innodb_log_file_size (not MySQL innodb_redo_log_capacity).
# innodb_flush_method is deprecated since 11.0; use the four Boolean I/O flags.
# --------------------------
innodb_buffer_pool_size              = 1G
innodb_log_file_size                 = 256M
innodb_flush_log_at_trx_commit       = 1
innodb_data_file_buffering           = OFF
innodb_data_file_write_through       = OFF
innodb_log_file_buffering            = OFF
innodb_log_file_write_through        = OFF
innodb_use_native_aio                = ON
innodb_doublewrite                   = ON

# AHI is compiled in (WITH_INNODB_AHI=ON) but MariaDB 10.5+ runtime default is OFF.

[mariadb-client]
default-character-set                = utf8mb4
local-infile                         = 0
safe-updates                         = 1
max-allowed-packet                   = 64M

[mariadb-dump]
default-character-set                = utf8mb4
max-allowed-packet                   = 64M
quick                                = 1
comments                             = 1

[mariadb-import]
default-character-set                = utf8mb4

[mariadb-check]
default-character-set                = utf8mb4

[mariadb-upgrade]
default-character-set                = utf8mb4

[mariadb-show]
default-character-set                = utf8mb4

[mariadbd-safe]
open-files-limit                     = 32768
log-error                            = /data/mysql/mariadb_error.log
